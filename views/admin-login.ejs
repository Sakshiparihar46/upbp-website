<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= setupMode ? 'Admin setup' : 'Admin sign in' %> | U.P. Boxing Association</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
  <main class="login-shell">
    <a class="brand-mark" href="/admin" aria-label="U.P. Boxing Association home">UPBA <span>ADMIN</span></a>
    <p class="eyebrow"><%= setupMode ? 'FIRST-TIME SETUP' : 'STAFF ACCESS' %></p>
    <h1><%= setupMode ? 'Create admin account' : 'Sign in' %></h1>
    <p class="muted"><%= setupMode ? 'Use the one-time setup code printed in the server startup logs.' : 'Registration and payment administration' %></p>
    <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
    <% if (setupMode) { %>
      <form method="POST" action="/admin/setup" class="login-form">
        <label for="setupToken">One-time setup code</label>
        <input id="setupToken" name="setup_token" autocomplete="off" required>
        <label for="username">Admin username</label>
        <input id="username" name="username" autocomplete="username" minlength="3" maxlength="50" pattern="[A-Za-z0-9._-]+" required>
        <label for="password">Admin password (at least 12 characters)</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required>
        <label for="confirmPassword">Confirm password</label>
        <input id="confirmPassword" name="confirm_password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required>
        <button class="button primary wide" type="submit">Create admin account <span aria-hidden="true">→</span></button>
      </form>
    <% } else { %>
      <form method="POST" action="/admin/login" class="login-form">
        <label for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required autofocus>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button class="button primary wide" type="submit">Sign in <span aria-hidden="true">→</span></button>
      </form>
    <% } %>
    <a class="back-link" href="/">← Return to registration</a>
  </main>
</body>
</html>
