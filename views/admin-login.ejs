<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin sign in | U.P. Boxing Association</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
  <main class="login-shell">
    <a class="brand-mark" href="/admin" aria-label="U.P. Boxing Association home">UPBA <span>ADMIN</span></a>
    <p class="eyebrow">STAFF ACCESS</p>
    <h1>Sign in</h1>
    <p class="muted">Registration and payment administration</p>
    <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
    <form method="POST" action="/admin/login" class="login-form">
      <label for="username">Username</label>
      <input id="username" name="username" autocomplete="username" required autofocus>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button class="button primary wide" type="submit">Sign in <span aria-hidden="true">→</span></button>
    </form>
    <a class="back-link" href="/">← Return to registration</a>
  </main>
</body>
</html>
